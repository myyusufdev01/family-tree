# ===== Backend (FastAPI) =====
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
FIRESTORE_PROJECT_ID=your_project_id_here
# Opsional: API key untuk melindungi endpoint backend
API_KEY=your_secret_api_key

# ── Auth0 (backend) ──────────────────────────────────────────────────────────
# Tenant Auth0 dan identifier API. AUTH0_AUDIENCE harus sama dengan frontend.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://family-tree-api
# Auth0 user ID (`sub`) yang berhak akses admin, dipisah koma.
ADMIN_SUBS=

# Opsional: origin frontend yang diizinkan (CORS), dipisah koma
# CORS_ORIGINS=http://localhost:3000,https://your-app.example.com

# ===== Frontend (Next.js) =====
# URL API backend untuk frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Auth0 (frontend) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://family-tree-api
