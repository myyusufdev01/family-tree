# ===== Family Tree — Environment (.env.local di folder frontend/) =====
# Aplikasi kini satu project Next.js (UI + API + akses Firestore).
# Salin sebagai `frontend/.env.local` dan isi sesuai project-mu.
#
# Variabel tanpa prefix NEXT_PUBLIC_ bersifat server-only (tidak pernah
# terkirim ke browser). Variabel NEXT_PUBLIC_* di-inline ke bundle browser.

# ── Firestore (server-only) ──────────────────────────────────────────────────
# Lokasi service account key untuk dev lokal (file di frontend/). Di Cloud Run
# tidak perlu file ini — memakai service account yang menempel pada service.
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
FIRESTORE_PROJECT_ID=your_project_id_here

# ── Auth0 (server) ────────────────────────────────────────────────────────────
# Tenant Auth0. Server memverifikasi token via /userinfo Auth0 — tidak perlu
# audience/API terpisah. Sama nilainya dengan NEXT_PUBLIC_AUTH0_DOMAIN.
AUTH0_DOMAIN=your-tenant.auth0.com
# Auth0 user ID (`sub`) yang berhak akses admin, dipisah koma.
# Lihat di Auth0 Dashboard → User Management → Users → "User ID".
ADMIN_SUBS=

# ── Auth0 (public — di-inline ke browser) ─────────────────────────────────────
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id

