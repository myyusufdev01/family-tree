GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
FIRESTORE_PROJECT_ID=your_project_id_here

# ── Auth0 ────────────────────────────────────────────────────────────────────
# Tenant Auth0 — dari Auth0 Dashboard (Applications → Settings → Domain).
# Backend memverifikasi token via endpoint /userinfo Auth0, jadi tidak perlu
# membuat API di Auth0 maupun mengisi audience.
AUTH0_DOMAIN=your-tenant.auth0.com

# Auth0 user ID (`sub`) yang berhak mengakses endpoint admin, dipisah koma.
# Cara melihatnya: Auth0 Dashboard → User Management → Users → klik user →
# salin field "User ID". Contoh format: "auth0|abc123" atau "google-oauth2|123456"
ADMIN_SUBS=

# Opsional: API key untuk melindungi endpoint backend
API_KEY=your_secret_api_key

# Opsional: origin frontend yang diizinkan (CORS), dipisah koma
# CORS_ORIGINS=http://localhost:3000,https://your-app.example.com
